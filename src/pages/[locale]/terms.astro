---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, locales } from '../../i18n/utils.js';

export async function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const { t } = useTranslations(locale);
---

<Layout title={t('terms.title')} description={t('terms.description')}>
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <h1 class="font-display text-2xl font-semibold text-ink dark:text-dark-ink tracking-tight">{t('terms.heading')}</h1>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray mt-1">{t('terms.lastUpdated')}</p>
    </div>

    <p class="text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">{t('terms.intro')}</p>

    <div>
      <p class="text-sm font-medium text-ink dark:text-dark-ink mb-1">{t('terms.noGuarantee')}</p>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">{t('terms.noGuaranteeText')}</p>
    </div>

    <div>
      <p class="text-sm font-medium text-ink dark:text-dark-ink mb-1">{t('terms.useAtOwnRisk')}</p>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">{t('terms.riskText')}</p>
    </div>

    <div>
      <p class="text-sm font-medium text-ink dark:text-dark-ink mb-1">{t('terms.trademarks')}</p>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">{t('terms.trademarksText')}</p>
    </div>

    <div>
      <p class="text-sm font-medium text-ink dark:text-dark-ink mb-1">{t('terms.changes')}</p>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">{t('terms.changesText')}</p>
    </div>

    <div>
      <p class="text-sm font-medium text-ink dark:text-dark-ink mb-1">{t('terms.contact')}</p>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed" set:html={t('terms.contactText', { email: '<a href="mailto:runfps40@gmail.com" class="text-ink dark:text-dark-ink underline underline-offset-2 hover:text-ember transition-colors duration-120">runfps40@gmail.com</a>' })}></p>
    </div>
  </div>
</Layout>

