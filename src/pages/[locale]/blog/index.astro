---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations, locales } from '../../../i18n/utils.js';
import blogData from '../../../data/blog.json';

export async function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const { t } = useTranslations(locale);
const posts = [...blogData.posts].sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title={t('blog.title')} description={t('blog.description')}>
  <div class="max-w-2xl mx-auto space-y-6">
    <div>
      <h1 class="font-display text-2xl font-semibold text-ink dark:text-dark-ink tracking-tight">{t('blog.heading')}</h1>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray mt-1">{t('blog.tagline')}</p>
    </div>

    <div class="space-y-3">
      {posts.map(post => (
        <a href={`/${locale}/blog/${post.slug}`} class="card no-underline block group">
          <div class="flex items-start justify-between gap-2">
            <h2 class="font-display font-medium text-base text-ink dark:text-dark-ink leading-snug group-hover:text-ember transition-colors duration-120">{post.title}</h2>
            <span class="shrink-0 text-xs font-mono text-mid-gray dark:text-dark-mid-gray">{post.date}</span>
          </div>
          <p class="mt-1.5 text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">{post.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
