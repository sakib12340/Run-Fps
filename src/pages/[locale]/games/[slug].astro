---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations, locales } from '../../../i18n/utils.js';
import gamesData from '../../../data/games.json';
import { gameBlurbs } from '../../../data/game-blurbs.js';
import { genreLabels } from '../../../data/genres.js';
import { getProfile } from '../../../data/profiles.js';
import { profileTranslations } from '../../../data/profiles-i18n.js';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    for (const game of gamesData.games) {
      paths.push({ params: { locale, slug: game.id }, props: { game } });
    }
  }
  return paths;
}

const { locale } = Astro.params;
const { game } = Astro.props;
const { t } = useTranslations(locale);
const profile = getProfile(game.id);
const localizedProfile = locale !== 'en'
  ? profileTranslations[game.id as keyof typeof profileTranslations]?.[locale as keyof typeof profileTranslations[keyof typeof profileTranslations]] ?? null
  : null;
const genreLabel = genreLabels[game.genre] || game.genre;

const gameSchema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": game.title,
  "description": `Check FPS estimates for ${game.title} across 5 hardware tiers at 1080p and 1440p. System requirements: ${game.ramRequirement}GB RAM, ${game.vramRequirement}GB VRAM.`,
  "genre": genreLabel,
  "applicationCategory": "Game",
  "operatingSystem": "Windows",
  "author": {
    "@type": "Organization",
    "name": game.developer
  },
  "datePublished": `${game.releaseYear}`,
  "url": `https://runfps.com/${locale}/games/${game.id}/`,
  "image": `https://runfps.com/web-app-manifest-512x512.png`,
  "inLanguage": locale
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How many FPS will I get in ${game.title}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${game.title} needs about ${game.ramRequirement}GB RAM and ${game.vramRequirement}GB VRAM. FPS depends on your GPU and CPU — check the estimates table above across 5 hardware tiers at 1080p High, or run your exact parts through the FPS calculator.`
      }
    },
    {
      "@type": "Question",
      "name": `What are the system requirements for ${game.title}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${game.title} (${game.releaseYear}) requires approximately ${game.ramRequirement}GB RAM and ${game.vramRequirement}GB VRAM. It supports ${[game.dlss && "DLSS", game.fsr && "FSR"].filter(Boolean).join(" and ") || "no upscaling"}.`
      }
    },
    {
      "@type": "Question",
      "name": `How do I boost FPS in ${game.title}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Enable ${[game.dlss && "DLSS Quality", game.fsr && "FSR Balanced"].filter(Boolean).join(" or ") || "upscaling if available"}, lower shadows and volumetrics first, and keep textures high if your VRAM covers it. Use the settings optimizer for your target FPS.`
      }
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://runfps.com/${locale}/` },
    { "@type": "ListItem", "position": 2, "name": t('games.index.heading'), "item": `https://runfps.com/${locale}/games/` },
    { "@type": "ListItem", "position": 3, "name": game.title, "item": `https://runfps.com/${locale}/games/${game.id}/` }
  ]
};

const tiers = [
  { name: t('games.detail.budget'), score: 65, gpu: "RTX 3060", cpu: "Ryzen 5 5600X" },
  { name: t('games.detail.mid'), score: 72, gpu: "RTX 4060", cpu: "Ryzen 5 7600X" },
  { name: t('games.detail.high'), score: 82, gpu: "RTX 4070 Super", cpu: "Ryzen 7 7800X3D" },
  { name: t('games.detail.enthusiast'), score: 92, gpu: "RTX 4080 Super", cpu: "Ryzen 9 7950X3D" },
  { name: t('games.detail.ultra'), score: 100, gpu: "RTX 5090", cpu: "Core Ultra 9 285K" },
];

function getFpsAtScore(curve: { gpuScore: number; fps: number }[], score: number) {
  for (let i = 0; i < curve.length - 1; i++) {
    if (score >= curve[i].gpuScore && score <= curve[i + 1].gpuScore) {
      const t = (score - curve[i].gpuScore) / (curve[i + 1].gpuScore - curve[i].gpuScore);
      return Math.round(curve[i].fps + t * (curve[i + 1].fps - curve[i].fps));
    }
  }
  return score <= curve[0].gpuScore ? curve[0].fps : curve[curve.length - 1].fps;
}

const curve = game.performanceCurve;
const relatedGames = gamesData.games.filter(g => g.genre === game.genre && g.id !== game.id).slice(0, 4);
const gameParam = game.title.toLowerCase().replace(/\s+/g, '-');
const blurb = (gameBlurbs as Record<string, string>)[game.id] ?? null;
---

<Layout title={t('games.detail.title', { game: game.title })} description={t('games.detail.description', { game: game.title, ram: game.ramRequirement, vram: game.vramRequirement })}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(gameSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<div class="py-6">
  <nav aria-label="Breadcrumb" class="mb-4">
    <ol class="flex items-center gap-1.5 text-xs text-mid-gray dark:text-dark-mid-gray font-mono">
      <li><a href={`/${locale}/`} class="hover:text-ink dark:hover:text-dark-ink transition-colors">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`/${locale}/games`} class="hover:text-ink dark:hover:text-dark-ink transition-colors">{t('games.index.heading')}</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink dark:text-dark-ink truncate max-w-[180px]">{game.title}</li>
    </ol>
  </nav>
  <div class="flex items-center gap-3 flex-wrap">
    <span class={`badge badge-${game.genre}`}>{genreLabel}</span>
    <span class={`badge capitalize ${game.optimizationTier === 'light' ? 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800' : game.optimizationTier === 'medium' ? 'bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800' : 'bg-rose-50 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 border-rose-200 dark:border-rose-800'}`}>{game.optimizationTier}</span>
    {game.steamDeck && <span class="badge bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800">&#10003; {t('games.detail.steamDeck')}</span>}
    {game.dlss && <span class="badge bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800">DLSS</span>}
    {game.fsr && <span class="badge bg-purple-50 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 border border-purple-200 dark:border-purple-800">FSR</span>}
  </div>

  <h1 class="mt-4 font-display text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-[-0.03em] text-ink dark:text-dark-ink leading-[1.1]">{game.title}</h1>
  <p class="mt-2 text-mid-gray dark:text-dark-mid-gray text-sm">{game.developer} &middot; {game.releaseYear}</p>
  <p class="mt-3 text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed max-w-2xl">Wondering how many FPS you'll get in {game.title}? The table below shows estimates across 5 PC tiers at 1080p High. {game.title} needs about {game.ramRequirement}GB RAM and {game.vramRequirement}GB VRAM — <a href={`/${locale}/calculator?game=${gameParam}`} class="underline underline-offset-2">check your exact GPU + CPU here</a>.</p>
  {blurb && <p class="mt-3 text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed max-w-2xl">{blurb}</p>}

  <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="lg:col-span-2">
      <div class="card">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-dark-ink">{t('games.detail.fpsEstimates')}</h2>
        <p class="mt-1 text-xs text-mid-gray dark:text-dark-mid-gray font-mono">{t('games.detail.estimatedFps')}</p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-hairline dark:border-dark-hairline">
                <th class="text-left py-2 pr-4 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">{t('games.detail.tier')}</th>
                <th class="text-left py-2 px-4 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">{t('games.detail.hardware')}</th>
                <th class="text-right py-2 px-2 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">{t('games.detail.low')}</th>
                <th class="text-right py-2 px-2 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">{t('games.detail.med')}</th>
                <th class="text-right py-2 px-2 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">{t('games.detail.high')}</th>
                <th class="text-right py-2 pl-4 font-mono text-xs text-mid-gray dark:text-dark-mid-gray uppercase tracking-wider">{t('games.detail.ultra')}</th>
              </tr>
            </thead>
            <tbody>
              {tiers.map((tier) => {
                const fpsHigh = getFpsAtScore(curve, tier.score);
                const fpsLow = Math.round(fpsHigh * 1.4);
                const fpsMed = Math.round(fpsHigh * 1.15);
                const fpsUltra = Math.round(fpsHigh * 0.7);
                return (
                  <tr class="border-b border-hairline dark:border-dark-hairline">
                    <td class="py-2 pr-4 font-medium text-ink dark:text-dark-ink whitespace-nowrap">{tier.name}</td>
                    <td class="py-2 px-4 text-mid-gray dark:text-dark-mid-gray text-xs font-mono whitespace-nowrap">{tier.gpu} / {tier.cpu}</td>
                    <td class="text-right py-2 px-2 font-mono text-ink dark:text-dark-ink">{fpsLow}</td>
                    <td class="text-right py-2 px-2 font-mono text-ink dark:text-dark-ink">{fpsMed}</td>
                    <td class="text-right py-2 px-2 font-mono text-ink dark:text-dark-ink font-semibold">{fpsHigh}</td>
                    <td class="text-right py-2 pl-4 font-mono text-ink dark:text-dark-ink">{fpsUltra}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div>
      <div class="card">
        <h2 class="font-display text-lg font-semibold text-ink dark:text-dark-ink">{t('games.detail.systemRequirements')}</h2>
        <div class="mt-3 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">{t('games.detail.ram')}</span>
            <span class="text-sm font-mono font-medium text-ink dark:text-dark-ink">{game.ramRequirement} GB</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">{t('games.detail.vram')}</span>
            <span class="text-sm font-mono font-medium text-ink dark:text-dark-ink">{game.vramRequirement} GB</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">{t('games.detail.genre')}</span>
            <span class="text-sm font-mono font-medium text-ink dark:text-dark-ink">{genreLabel}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">{t('games.detail.developer')}</span>
            <span class="text-sm font-mono font-medium text-ink dark:text-dark-ink">{game.developer}</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm text-mid-gray dark:text-dark-mid-gray">{t('games.detail.releaseYear')}</span>
            <span class="text-sm font-mono font-medium text-ink dark:text-dark-ink">{game.releaseYear}</span>
          </div>
        </div>
      </div>

      {(profile || localizedProfile) && (
        <div class="card mt-4">
          <div class="flex items-baseline justify-between gap-2">
            <h2 class="font-display text-sm font-medium text-ink dark:text-dark-ink">{(localizedProfile || profile).title}</h2>
            <span class="text-xs font-mono text-ember shrink-0">{(localizedProfile || profile).target}</span>
          </div>
          <p class="mt-1 text-xs text-mid-gray dark:text-dark-mid-gray leading-relaxed">{(localizedProfile || profile).focus}</p>
          <ul class="mt-3 space-y-1.5">
            {(localizedProfile || profile).tips.map((tip: string | { text: string; impact: string }) => (
              <li class="flex items-start justify-between gap-3 text-sm">
                {typeof tip === 'string' ? (
                  <span class="text-ink dark:text-dark-ink leading-snug">{tip}</span>
                ) : (
                  <>
                    <span class="text-ink dark:text-dark-ink leading-snug">{tip.text}</span>
                    <span class="shrink-0 font-mono text-xs text-mid-gray dark:text-dark-mid-gray">{tip.impact}</span>
                  </>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </div>

  <div class="mt-8 card">
    <h2 class="font-display text-lg font-semibold text-ink dark:text-dark-ink">{game.title} FAQ</h2>
    <div class="mt-3 space-y-4">
      <div>
        <h3 class="text-sm font-medium text-ink dark:text-dark-ink">How many FPS will I get in {game.title}?</h3>
        <p class="mt-1 text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">FPS depends on your GPU and CPU. The estimates table above shows 5 hardware tiers at 1080p High — {game.title} needs about {game.ramRequirement}GB RAM and {game.vramRequirement}GB VRAM. Run your exact parts through the <a href={`/${locale}/calculator?game=${gameParam}`} class="underline underline-offset-2">FPS calculator</a> for your number.</p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-ink dark:text-dark-ink">What are the system requirements for {game.title}?</h3>
        <p class="mt-1 text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">{game.title} ({game.releaseYear}) by {game.developer} requires approximately {game.ramRequirement}GB RAM and {game.vramRequirement}GB VRAM.</p>
      </div>
      <div>
        <h3 class="text-sm font-medium text-ink dark:text-dark-ink">How do I boost FPS in {game.title}?</h3>
        <p class="mt-1 text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">Enable upscaling if available, lower shadows and volumetrics first, and keep textures high if your VRAM covers it. Use the <a href={`/${locale}/optimizer`} class="underline underline-offset-2">settings optimizer</a> for your target FPS.</p>
      </div>
    </div>
  </div>

  {relatedGames.length > 0 && (
    <div class="mt-8">
      <h2 class="font-display text-lg font-semibold text-ink dark:text-dark-ink">More {genreLabel} games</h2>
      <div class="mt-3 grid grid-cols-2 sm:grid-cols-4 gap-3">
        {relatedGames.map(r => (
          <a href={`/${locale}/games/${r.id}`} class="card no-underline block">
            <div class="font-display font-medium text-sm text-ink dark:text-dark-ink truncate">{r.title}</div>
            <div class="mt-1 text-xs text-mid-gray dark:text-dark-mid-gray font-mono">{r.releaseYear}</div>
          </a>
        ))}
      </div>
    </div>
  )}
</div>

</Layout>

