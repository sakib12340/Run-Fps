---
import Layout from '../../../../layouts/Layout.astro';
import { useTranslations, locales } from '../../../../i18n/utils.js';
import { cpus } from '../../../../data/cpus.json';
import { gpus } from '../../../../data/gpus.json';
import { games } from '../../../../data/games.json';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    for (const cpu of cpus) {
      paths.push({ params: { locale, slug: cpu.id }, props: { cpu } });
    }
  }
  return paths;
}

const { locale } = Astro.params;
const { cpu } = Astro.props;
const { t } = useTranslations(locale);
const topGpus = [...gpus].sort((a, b) => b.score - a.score).slice(0, 4);
const topGames = games.slice(0, 8);
// master-code: duplicated engine math for SSR first-paint; client engine.js stays authoritative
function interpolate(point: number, curve: any[]) {
  const sorted = [...curve].sort((a: any, b: any) => a.gpuScore - b.gpuScore);
  if (point <= sorted[0].gpuScore) return sorted[0].fps;
  if (point >= sorted[sorted.length - 1].gpuScore) return sorted[sorted.length - 1].fps;
  let i = 0;
  while (i < sorted.length - 1 && sorted[i + 1].gpuScore <= point) i++;
  if (i === 0) i = 1;
  if (i >= sorted.length - 1) i = sorted.length - 2;
  const p0 = sorted[i - 1], p1 = sorted[i], p2 = sorted[i + 1], p3 = sorted[Math.min(i + 2, sorted.length - 1)];
  const t = (point - p1.gpuScore) / (p2.gpuScore - p1.gpuScore);
  const t2 = t * t, t3 = t2 * t;
  return 0.5 * ((2 * p1.fps) + (-p0.fps + p2.fps) * t + (2 * p0.fps - 5 * p1.fps + 4 * p2.fps - p3.fps) * t2 + (-p0.fps + 3 * p1.fps - 3 * p2.fps + p3.fps) * t3);
}
function ssrFps(game: any, gpuItem: any, cpuItem: any) {
  const base = interpolate(gpuItem.score, game.performanceCurve);
  const cpuFactor = 1.0 - (game.cpuWeight * (1.0 - cpuItem.score / 100));
  return Math.round(base * cpuFactor * 0.9);
}
---

<Layout title={`${cpu.name} - ${t('benchmarks.cpu.title')}`} description={`${cpu.name} ${t('misc.estimatedFps')} ${topGames.length} games.`}>
<script is:inline src="/engine.js" type="module"></script>

<script type="application/json" id="cpu-data" set:html={JSON.stringify(cpu)}></script>
<script type="application/json" id="gpus-data" set:html={JSON.stringify(topGpus)}></script>
<script type="application/json" id="games-data" set:html={JSON.stringify(topGames)}></script>

<div class="space-y-6">
  <div class="card">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h1 class="font-display text-2xl font-semibold text-ink dark:text-dark-ink tracking-tight">{cpu.name}</h1>
        <p class="text-sm text-mid-gray dark:text-dark-mid-gray">{cpu.brand} &middot; {cpu.generation} &middot; {t('misc.estimatedFps')} {cpu.launchYear}</p>
      </div>
      <span class="badge text-xs" class:list={[cpu.brand === 'intel' ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200']}>{cpu.brand}</span>
    </div>

    <div class="mb-4">
      <div class="flex justify-between text-sm font-mono mb-1">
        <span class="text-mid-gray dark:text-dark-mid-gray">{t('benchmarks.cpu.performanceScore')}</span>
        <span class="text-ink dark:text-dark-ink font-semibold">{cpu.score}/100</span>
      </div>
      <div class="h-3 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
        <div class="h-full rounded-full transition-all" style={`width:${cpu.score}%`} class:list={[cpu.score >= 80 ? 'bg-emerald-500' : cpu.score >= 60 ? 'bg-amber-500' : cpu.score >= 40 ? 'bg-orange-500' : 'bg-red-500']}></div>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
      <div class="p-3 bg-canvas dark:bg-dark-canvas rounded-card">
        <div class="font-display text-lg font-semibold text-ink dark:text-dark-ink">{cpu.cores}C / {cpu.threads}T</div>
        <div class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono">{t('benchmarks.cpu.coresThreads')}</div>
      </div>
      <div class="p-3 bg-canvas dark:bg-dark-canvas rounded-card">
        <div class="font-display text-lg font-semibold text-ink dark:text-dark-ink">{cpu.tdp}W</div>
        <div class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono">{t('benchmarks.cpu.tdp')}</div>
      </div>
      <div class="p-3 bg-canvas dark:bg-dark-canvas rounded-card">
        <div class="font-display text-lg font-semibold text-ink dark:text-dark-ink">{cpu.launchYear}</div>
        <div class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono">{t('benchmarks.cpu.launchYear')}</div>
      </div>
      <div class="p-3 bg-canvas dark:bg-dark-canvas rounded-card">
        <div class="font-display text-lg font-semibold text-ink dark:text-dark-ink">{cpu.tier}</div>
        <div class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono">{t('benchmarks.cpu.tier')}</div>
      </div>
    </div>
  </div>

  <div class="card">
    <h2 class="font-display text-lg font-semibold text-ink dark:text-dark-ink mb-4">{t('misc.estimatedFps')} {topGames.length} Games</h2>
    <p class="text-xs text-mid-gray dark:text-dark-mid-gray mb-4 font-mono">Using RTX 4090, 16GB DDR5-6000, NVMe at 1080p High preset.</p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-hairline dark:border-dark-hairline">
            <th scope="col" class="text-left py-2 pr-4 font-mono text-xs text-mid-gray dark:text-dark-mid-gray font-medium">Game</th>
            {topGpus.map((g, i) => (
              <th scope="col" id={"fps-header-" + i} class="text-right px-2 py-2 font-mono text-xs text-mid-gray dark:text-dark-mid-gray font-medium">{g.name}</th>
            ))}
          </tr>
        </thead>
        <tbody id="fps-body">
          {topGames.map(game => (
            <tr class="border-b border-hairline dark:border-dark-hairline">
              <td class="py-2 pr-4 text-ink dark:text-dark-ink font-medium">{game.title}</td>
              {topGpus.map(g => (
                <td class="text-right px-2 py-2 font-mono text-ink dark:text-dark-ink">{ssrFps(game, g, cpu)}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
(async function() {
  const cpu = JSON.parse(document.getElementById('cpu-data')!.textContent ?? '');
  const gpus: any[] = JSON.parse(document.getElementById('gpus-data')!.textContent ?? '');
  const games: any[] = JSON.parse(document.getElementById('games-data')!.textContent ?? '');
  const engine = window.RunFpsEngine;
  if (!engine) return;
  const config = { ramCapacity: 16, ramType: 'ddr5', ramSpeed: 6000, ramChannel: 'dual', storage: 'nvme', resolution: '1080p', preset: 'high', rtEnabled: false, upscaling: 'none', resolutionScale: 100, frameCap: 0, monitorHz: 144, vramLimit: 0, os: 'windows' };
  const body = document.getElementById('fps-body')!;
  body.innerHTML = games.map(game => {
    const f = gpus.map(g => {
      const result = engine.calculateFPS(config, game, g, cpu);
      return result.avgFps;
    });
    return `<tr class="border-b border-hairline dark:border-dark-hairline">
      <td class="py-2 pr-4 text-ink dark:text-dark-ink font-medium">${game.title}</td>
      ${f.map(v => `<td class="text-right px-2 py-2 font-mono text-ink dark:text-dark-ink">${v}</td>`).join('')}
    </tr>`;
  }).join('');
})();
</script>

</Layout>

