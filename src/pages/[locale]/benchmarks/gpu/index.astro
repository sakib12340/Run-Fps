---
import Layout from '../../../../layouts/Layout.astro';
import { useTranslations, locales } from '../../../../i18n/utils.js';
import { gpus } from '../../../../data/gpus.json';

export async function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const { t } = useTranslations(locale);

const brands = [...new Set(gpus.map(g => g.brand))];
const tiers = [...new Set(gpus.map(g => g.tier))];
const sorted = [...gpus].sort((a, b) => b.score - a.score);
const initialGpus = sorted.slice(0, 24);
const ui = {
  showMore: t('benchmarks.gpu.showMore'),
  search: t('benchmarks.gpu.search'),
  count: t('benchmarks.gpu.count', { count: '{n}' }),
  countOf: t('benchmarks.gpu.countOf', { filtered: '{f}', total: '{t}' }),
  bestFor: t('benchmarks.gpu.bestFor', { res: '{res}' }),
  bestForEsports: t('benchmarks.gpu.bestForEsports')
};
---

<Layout title={t('benchmarks.gpu.title')} description={t('benchmarks.gpu.description', { count: gpus.length })}>

<div class="space-y-6">
  <div>
    <h1 class="font-display text-2xl font-semibold text-ink dark:text-dark-ink tracking-tight">{t('benchmarks.gpu.heading')}</h1>
    <p class="text-sm text-mid-gray dark:text-dark-mid-gray mt-1">{t('benchmarks.gpu.subtitle', { count: gpus.length })}</p>
  </div>

  <div class="flex flex-wrap gap-2">
    <button data-brand="all" class="brand-filter px-3 py-1.5 text-sm font-medium rounded-pill bg-ink text-paper dark:bg-dark-ink dark:text-dark-canvas border-0 cursor-pointer transition-all duration-120" aria-pressed="true">{t('benchmarks.gpu.allBrands')}</button>
    {brands.map(b => (
      <button data-brand={b} class="brand-filter px-3 py-1.5 text-sm font-medium rounded-pill bg-canvas dark:bg-dark-canvas text-mid-gray dark:text-dark-mid-gray border border-hairline dark:border-dark-hairline cursor-pointer transition-all duration-120 hover:bg-hairline dark:hover:bg-dark-hairline" aria-pressed="false">{b.charAt(0).toUpperCase() + b.slice(1)}</button>
    ))}
  </div>

  <div class="flex flex-wrap gap-2">
    <button data-tier="all" class="tier-filter px-3 py-1.5 text-sm font-medium rounded-pill bg-ink text-paper dark:bg-dark-ink dark:text-dark-canvas border-0 cursor-pointer transition-all duration-120" aria-pressed="true">{t('benchmarks.gpu.allTiers')}</button>
    {tiers.map(t => (
      <button data-tier={t} class="tier-filter px-3 py-1.5 text-sm font-medium rounded-pill bg-canvas dark:bg-dark-canvas text-mid-gray dark:text-dark-mid-gray border border-hairline dark:border-dark-hairline cursor-pointer transition-all duration-120 hover:bg-hairline dark:hover:bg-dark-hairline" aria-pressed="false">{t.charAt(0).toUpperCase() + t.slice(1)}</button>
    ))}
  </div>

  <div class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
    <label for="gpu-search" class="sr-only">{t('benchmarks.gpu.search')}</label>
    <input type="text" id="gpu-search" placeholder={t('benchmarks.gpu.search')} class="flex-1 w-full sm:max-w-xs px-4 py-2 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:ring-1 focus:ring-ember transition-colors duration-150" />
    <label for="gpu-sort" class="sr-only">{t('misc.sort')}</label>
    <select id="gpu-sort" class="px-3 py-2 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none appearance-none">
      <option value="score-desc">{t('benchmarks.gpu.sortScoreDesc')}</option>
      <option value="score-asc">{t('benchmarks.gpu.sortScoreAsc')}</option>
      <option value="vram-desc">{t('benchmarks.gpu.sortVramDesc')}</option>
      <option value="tdp-asc">{t('benchmarks.gpu.sortTdpAsc')}</option>
      <option value="year-desc">{t('benchmarks.gpu.sortYearDesc')}</option>
      <option value="name-asc">{t('benchmarks.gpu.sortNameAsc')}</option>
    </select>
  </div>

  <p id="gpu-result-count" class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono" aria-live="polite" aria-atomic="true">{t('benchmarks.gpu.count', { count: gpus.length })}</p>

  <div id="gpu-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {initialGpus.map(g => (
      <a href={`/${locale}/benchmarks/gpu/${g.id}`} class="card flex flex-col gap-3 no-underline group">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="font-display text-base font-medium text-ink dark:text-dark-ink group-hover:text-ember transition-colors duration-120">{g.name}</h2>
            <span class="text-xs text-mid-gray dark:text-dark-mid-gray">{g.brand} &middot; {g.generation}</span>
          </div>
          <span class="badge text-xs">{g.brand}</span>
        </div>
        <div>
          <div class="flex justify-between text-xs font-mono mb-1">
            <span class="text-mid-gray dark:text-dark-mid-gray">{t('compare.score')}</span>
            <span class="text-ink dark:text-dark-ink font-semibold">{g.score}/100</span>
          </div>
          <div class="h-2 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
            <div class="h-full rounded-full bg-mid-gray dark:bg-dark-mid-gray" style={`width:${g.score}%`}></div>
          </div>
        </div>
        <div class="flex items-center gap-3 text-xs text-mid-gray dark:text-dark-mid-gray font-mono">
          <span>{g.vram}GB VRAM</span>
          <span>{g.tdp}W</span>
          <span>{g.launchYear}</span>
        </div>
      </a>
    ))}
  </div>

  <div id="see-more-container" class="mt-6 text-center hidden">
    <button id="see-more-btn" class="px-5 py-2 bg-canvas dark:bg-dark-paper text-ink dark:text-dark-ink text-sm font-medium rounded-pill border border-hairline dark:border-dark-hairline cursor-pointer hover:scale-[1.02] transition-all duration-120">{ui.showMore}</button>
  </div>
</div>

<script type="application/json" id="gpus-data" set:html={JSON.stringify(sorted)}></script>
<script type="application/json" id="gpu-i18n" set:html={JSON.stringify(ui)}></script>
<script is:inline>
const ui = JSON.parse(document.getElementById('gpu-i18n').textContent);
const gpus = JSON.parse(document.getElementById('gpus-data').textContent);
const gpuGrid = document.getElementById('gpu-grid');
const countEl = document.getElementById('gpu-result-count');
const searchEl = document.getElementById('gpu-search');
const sortEl = document.getElementById('gpu-sort');

let activeBrand = 'all';
let activeTier = 'all';
let searchQuery = '';
let sortBy = 'score-desc';
let visibleCount = 24;
const PAGE_SIZE = 24;

function render() {
  let filtered = gpus.filter(g => {
    const matchesBrand = activeBrand === 'all' || g.brand === activeBrand;
    const matchesTier = activeTier === 'all' || g.tier === activeTier;
    const matchesSearch = g.name.toLowerCase().includes(searchQuery);
    return matchesBrand && matchesTier && matchesSearch;
  });

  filtered.sort((a, b) => {
    switch (sortBy) {
      case 'score-asc': return a.score - b.score;
      case 'vram-desc': return b.vram - a.vram;
      case 'tdp-asc': return a.tdp - b.tdp;
      case 'year-desc': return b.launchYear - a.launchYear;
      case 'name-asc': return a.name.localeCompare(b.name);
      default: return b.score - a.score;
    }
  });

  countEl.textContent = filtered.length === gpus.length ? ui.count.replace('{n}', gpus.length) : ui.countOf.replace('{f}', filtered.length).replace('{t}', gpus.length);

  const show = filtered.slice(0, visibleCount);
  gpuGrid.innerHTML = show.map(g => {
    const brandColor = g.brand === 'nvidia' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200' : g.brand === 'amd' ? 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200' : 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
    const barColor = g.score >= 80 ? 'bg-emerald-500' : g.score >= 60 ? 'bg-amber-500' : g.score >= 40 ? 'bg-orange-500' : 'bg-red-500';
    const bestForLabel = (score) => {
      if (score >= 85) return ui.bestFor.replace('{res}', '4K');
      if (score >= 65) return ui.bestFor.replace('{res}', '1440p');
      if (score >= 45) return ui.bestFor.replace('{res}', '1080p');
      return ui.bestForEsports;
    };
    return `<div class="card flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-display text-base font-medium text-ink dark:text-dark-ink">${g.name}</h2>
          <span class="text-xs text-mid-gray dark:text-dark-mid-gray">${g.brand} &middot; ${g.generation}</span>
        </div>
        <span class="badge text-xs ${brandColor}">${g.brand}</span>
      </div>
      <div>
        <div class="flex justify-between text-xs font-mono mb-1">
          <span class="text-mid-gray dark:text-dark-mid-gray">${g.score}</span>
          <span class="text-ink dark:text-dark-ink font-semibold">${g.score}/100</span>
        </div>
        <div class="h-2 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
          <div class="h-full rounded-full ${barColor}" style="width:${g.score}%"></div>
        </div>
      </div>
      <div class="text-xs font-medium text-ember dark:text-ember">${bestForLabel(g.score)}</div>
      <div class="flex items-center gap-3 text-xs text-mid-gray dark:text-dark-mid-gray font-mono">
        <span>${g.vram}GB VRAM</span>
        <span>${g.tdp}W</span>
        <span>${g.launchYear}</span>
      </div>
    </div>`;
  }).join('');

  const seeMore = document.getElementById('see-more-container');
  if (filtered.length > visibleCount) {
    const remaining = filtered.length - visibleCount;
    document.getElementById('see-more-btn').textContent = `${ui.showMore} (${remaining})`;
    seeMore.classList.remove('hidden');
  } else {
    seeMore.classList.add('hidden');
  }
}

document.getElementById('see-more-btn')?.addEventListener('click', () => {
  visibleCount += PAGE_SIZE;
  render();
});

document.querySelectorAll('.brand-filter').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.brand-filter').forEach(b => {
      b.className = 'brand-filter px-3 py-1.5 text-sm font-medium rounded-pill bg-canvas dark:bg-dark-canvas text-mid-gray dark:text-dark-mid-gray border border-hairline dark:border-dark-hairline cursor-pointer transition-all duration-120 hover:bg-hairline dark:hover:bg-dark-hairline';
      b.setAttribute('aria-pressed', 'false');
    });
    btn.className = 'brand-filter px-3 py-1.5 text-sm font-medium rounded-pill bg-ink text-paper dark:bg-dark-ink dark:text-dark-canvas border-0 cursor-pointer transition-all duration-120';
    btn.setAttribute('aria-pressed', 'true');
    activeBrand = btn.dataset.brand;
    visibleCount = PAGE_SIZE;
    render();
  });
});

document.querySelectorAll('.tier-filter').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tier-filter').forEach(b => {
      b.className = 'tier-filter px-3 py-1.5 text-sm font-medium rounded-pill bg-canvas dark:bg-dark-canvas text-mid-gray dark:text-dark-mid-gray border border-hairline dark:border-dark-hairline cursor-pointer transition-all duration-120 hover:bg-hairline dark:hover:bg-dark-hairline';
      b.setAttribute('aria-pressed', 'false');
    });
    btn.className = 'tier-filter px-3 py-1.5 text-sm font-medium rounded-pill bg-ink text-paper dark:bg-dark-ink dark:text-dark-canvas border-0 cursor-pointer transition-all duration-120';
    btn.setAttribute('aria-pressed', 'true');
    activeTier = btn.dataset.tier;
    visibleCount = PAGE_SIZE;
    render();
  });
});

searchEl.addEventListener('input', function() {
  searchQuery = this.value.toLowerCase();
  visibleCount = PAGE_SIZE;
  render();
});

sortEl.addEventListener('change', function() {
  sortBy = this.value;
  visibleCount = PAGE_SIZE;
  render();
});

render();
</script>

</Layout>

