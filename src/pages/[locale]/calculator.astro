---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, locales } from '../../i18n/utils.js';
import gpusData from '../../data/gpus.json';
import cpusData from '../../data/cpus.json';
import gamesData from '../../data/games.json';

export async function getStaticPaths() {
  return locales.map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const { t } = useTranslations(locale);
const ui = {
  averageFps: t('calculator.averageFps'),
  cappedAt: t('calculator.cappedAt', { fps: '{fps}' }),
  cpuUtil: t('calculator.cpuUtil'),
  bottleneck: t('calculator.bottleneck', { bottleneck: '{b}', percent: '{p}' }),
  fpsByPreset: t('calculator.fpsByPreset'),
  fpsByResolution: t('calculator.fpsByResolution'),
  upgradePath: t('calculator.upgradePath'),
  upgradeGpu: t('calculator.upgradeGpu'),
  upgradeCpu: t('calculator.upgradeCpu'),
  topTierCpu: t('calculator.topTierCpu'),
  topTierGpu: t('calculator.topTierGpu'),
  tips: t('calculator.tips'),
  noTips: t('calculator.noTips'),
  tipCpu: t('calculator.tipCpu', { cpu: '{cpu}', gpu: '{gpu}', percent: '{p}' }),
  tipGpu: t('calculator.tipGpu', { gpu: '{gpu}' }),
  tipRt: t('calculator.tipRt'),
  tipUpscaling: t('calculator.tipUpscaling'),
  tipFrameCap: t('calculator.tipFrameCap', { fps: '{fps}' }),
  low: t('calculator.low'),
  medium: t('calculator.medium'),
  high: t('calculator.high'),
  ultra: t('calculator.ultra'),
  on: t('calculator.on'),
  off: t('calculator.off'),
  none: t('calculator.none'),
  fps: t('misc.fps'),
  rating: t('calculator.rating'),
  noCpuGame: t('calculator.noCpuGame'),
  noGpu: t('calculator.noGpu', { cpu: '{cpu}' }),
  osWindows10: t('calculator.osWindows10'),
  osWindows11: t('calculator.osWindows11'),
  osLinux: t('calculator.osLinux'),
  calculate: t('calculator.calculate'),
  placeholderText: t('calculator.placeholder'),

  gpu: t('calculator.gpu'),
  cpu: t('calculator.cpu'),
  game: t('calculator.game'),
  ram: t('calculator.ram'),
  type: t('calculator.type'),
  resolution: t('calculator.resolution'),
  preset: t('calculator.preset'),
  searchGpu: t('calculator.searchGpu'),
  searchCpu: t('calculator.searchCpu'),
  searchGame: t('calculator.searchGame'),
  selectGpu: t('calculator.selectGpu'),
  selectCpu: t('calculator.selectCpu'),
  selectGame: t('calculator.selectGame'),
  advanced: t('calculator.advanced'),
  rayTracing: t('calculator.rayTracing'),
  upscaling: t('calculator.upscaling'),
  frameCap: t('calculator.frameCap'),
  storage: t('calculator.storage'),
  operatingSystem: t('calculator.operatingSystem')
};
---

<Layout title={t('calculator.title')} description={t('calculator.description')}>
<script is:inline src="/engine.js" type="module"></script>

<div class="grid grid-cols-1 lg:grid-cols-5 gap-4">
  <div class="lg:col-span-2">
    <div class="card space-y-3">
      <h1 class="font-display text-xl font-semibold text-ink dark:text-dark-ink tracking-tight">{t('calculator.heading')}</h1>
      <p class="text-sm text-mid-gray dark:text-dark-mid-gray">{t('calculator.subtitle')}</p>

      <div id="full-fields" class="space-y-3">
        <div>
          <label for="gpu" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.gpu')}</label>
          <input type="text" id="gpu-search" placeholder={t('calculator.searchGpu')} class="w-full px-3 py-1.5 mb-1.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-xs rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />
          <select id="gpu" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none"></select>
        </div>
        <div>
          <label for="cpu" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.cpu')}</label>
          <input type="text" id="cpu-search" placeholder={t('calculator.searchCpu')} class="w-full px-3 py-1.5 mb-1.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-xs rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />
          <select id="cpu" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none"></select>
        </div>
        <div>
          <label for="game" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.game')}</label>
          <input type="text" id="game-search" placeholder={t('calculator.searchGame')} class="w-full px-3 py-1.5 mb-1.5 bg-paper dark:bg-dark-paper text-ink dark:text-dark-ink text-xs rounded-pill border border-hairline dark:border-dark-hairline outline-none focus:border-ember focus:ring-1 focus:ring-ember/30 transition-colors duration-150" />
          <select id="game" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none"></select>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label for="ram-capacity" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.ram')}</label>
            <select id="ram-capacity" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
              <option value="4">4 GB</option>
              <option value="8">8 GB</option>
              <option value="16" selected>16 GB</option>
              <option value="32">32 GB</option>
              <option value="64">64 GB</option>
            </select>
          </div>
          <div>
            <label for="ram-type" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.type')}</label>
            <select id="ram-type" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
              <option value="ddr5" selected>DDR5</option>
              <option value="ddr4">DDR4</option>
              <option value="ddr3">DDR3</option>
              <option value="ddr2">DDR2</option>
            </select>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label for="resolution" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.resolution')}</label>
            <select id="resolution" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
              <option value="720p">720p</option>
              <option value="800p">800p</option>
              <option value="1080p" selected>1080p</option>
              <option value="1440p">1440p</option>
              <option value="4K">4K</option>
            </select>
          </div>
          <div>
            <label for="preset" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.preset')}</label>
            <select id="preset" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
              <option value="low">{t('calculator.low')}</option>
              <option value="medium">{t('calculator.medium')}</option>
              <option value="high" selected>{t('calculator.high')}</option>
              <option value="ultra">{t('calculator.ultra')}</option>
            </select>
          </div>
        </div>
        <div>
          <button id="advanced-toggle" type="button" class="text-sm text-mid-gray hover:text-ink dark:text-dark-mid-gray dark:hover:text-dark-ink transition-colors duration-120 cursor-pointer bg-transparent border-0 p-0" aria-expanded="false" aria-controls="advanced-options">+ {t('calculator.advanced')}</button>
          <div id="advanced-options" class="hidden mt-2 space-y-2">
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="rt" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.rayTracing')}</label>
                <select id="rt" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
                  <option value="false">{t('calculator.off')}</option>
                  <option value="true">{t('calculator.on')}</option>
                </select>
              </div>
              <div>
                <label for="upscaling" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.upscaling')}</label>
                <select id="upscaling" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
                  <option value="none">{t('calculator.none')}</option>
                  <option value="dlss_quality">DLSS Q</option>
                  <option value="dlss_balanced">DLSS B</option>
                  <option value="dlss_performance">DLSS P</option>
                  <option value="fsr_quality">FSR Q</option>
                  <option value="fsr_performance">FSR P</option>
                </select>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label for="frame-cap" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.frameCap')}</label>
                <select id="frame-cap" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
                  <option value="0">{t('calculator.none')}</option>
                  <option value="60">60 FPS</option>
                  <option value="120">120 FPS</option>
                  <option value="144">144 FPS</option>
                  <option value="240">240 FPS</option>
                </select>
              </div>
              <div>
                <label for="storage" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.storage')}</label>
                <select id="storage" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
                  <option value="nvme">NVMe</option>
                  <option value="ssd">SSD</option>
                  <option value="hdd">HDD</option>
                </select>
              </div>
            </div>
            <div>
              <label for="os" class="block text-sm font-medium text-ink dark:text-dark-ink mb-1.5">{t('calculator.operatingSystem')}</label>
              <select id="os" class="w-full px-3 py-2 bg-canvas dark:bg-dark-canvas text-ink dark:text-dark-ink text-sm rounded-pill border border-hairline dark:border-dark-hairline outline-none">
                <option value="windows">{ui.osWindows10}</option>
                <option value="windows11">{ui.osWindows11}</option>
                <option value="linux">{ui.osLinux}</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <button id="calculate-btn" class="w-full py-3 bg-ink dark:bg-dark-ink text-paper dark:text-dark-canvas rounded-pill text-sm font-medium cursor-pointer border-0 hover:scale-[1.02] transition-all duration-120 disabled:opacity-50 disabled:cursor-not-allowed">
        {ui.calculate}
      </button>
    </div>
  </div>

  <div class="lg:col-span-3">
    <div id="results-container" aria-live="polite" tabindex="-1">
      <div id="calc-skeleton" role="status" aria-live="polite" class="card space-y-4 p-6">
        <div class="skeleton skeleton-title"></div>
        <div class="skeleton skeleton-text" style="width:80%"></div>
        <div class="skeleton skeleton-bar"></div>
        <div class="skeleton skeleton-text" style="width:45%"></div>
        <div class="skeleton skeleton-bar"></div>
      </div>
      <div id="calc-placeholder" class="card flex flex-col items-center justify-center py-16 text-center hidden">
        <Icon name="lucide:calculator" size={40} class="text-hairline dark:text-dark-hairline mb-3" />
        <p class="text-mid-gray dark:text-dark-mid-gray text-sm">{ui.placeholderText}</p>
        <div class="flex items-center gap-3 mt-3 text-xs text-mid-gray dark:text-dark-mid-gray font-mono">
          <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-ember"></span> {ui.gpu}</span>
          <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-ink dark:bg-dark-ink"></span> {ui.cpu}</span>
          <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-mid-gray dark:bg-dark-mid-gray"></span> {ui.game}</span>
        </div>
      </div>
    </div>
    <div id="results" class="hidden space-y-4" aria-live="polite" tabindex="-1">
      <div class="card text-center">
        <div class="flex items-center justify-center gap-4">
          <div>
            <div id="fps-number" class="font-display text-6xl sm:text-7xl font-semibold tracking-[-0.04em] text-ink dark:text-dark-ink leading-none">0</div>
            <div id="fps-label" class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono mt-1">{ui.averageFps}</div>
          </div>
          <div class="text-left space-y-1">
            <div><span id="p1-low" class="font-mono text-sm text-ink dark:text-dark-ink">0</span> <span class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono">1% Low</span></div>
            <div><span id="p01-low" class="font-mono text-sm text-ink dark:text-dark-ink">0</span> <span class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono">0.1% Low</span></div>
            <div><span id="rating-badge" class="inline-block badge bg-ink-soft text-paper dark:bg-dark-ink-soft dark:text-dark-canvas">&ndash;</span></div>
          </div>
        </div>
      </div>

      <div class="card">
        <h2 class="font-display text-sm font-medium text-ink dark:text-dark-ink mb-3">{ui.cpuUtil}</h2>
        <div class="space-y-2">
          <div>
            <div class="flex justify-between text-xs text-mid-gray dark:text-dark-mid-gray font-mono mb-1"><span>CPU</span><span id="cpu-load-text">0%</span></div>
            <div class="h-2 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden"><div id="cpu-bar" class="h-full bg-ink dark:bg-dark-ink rounded-full transition-all duration-500" style="width:0%"></div></div>
          </div>
          <div>
            <div class="flex justify-between text-xs text-mid-gray dark:text-dark-mid-gray font-mono mb-1"><span>GPU</span><span id="gpu-load-text">0%</span></div>
            <div class="h-2 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden"><div id="gpu-bar" class="h-full bg-mid-gray dark:bg-dark-mid-gray rounded-full transition-all duration-500" style="width:0%"></div></div>
          </div>
          <div id="bottleneck-text" class="text-xs text-mid-gray dark:text-dark-mid-gray font-mono"></div>
        </div>
      </div>

      <div class="card">
        <h2 class="font-display text-sm font-medium text-ink dark:text-dark-ink mb-3">{ui.fpsByPreset}</h2>
        <div id="preset-breakdown" class="space-y-1.5"></div>
      </div>

      <div class="card">
        <div class="flex items-center justify-between mb-2">
          <h2 class="font-display text-sm font-medium text-ink dark:text-dark-ink">{ui.fpsByResolution}</h2>
          <span id="slider-fps" class="font-mono text-sm font-semibold text-ember"></span>
        </div>
        <input type="range" id="res-slider" min="0" max="4" step="1" value="2" class="w-full h-1.5 bg-canvas dark:bg-dark-canvas rounded-full appearance-none cursor-pointer accent-ember mb-3" aria-label="Adjust resolution" />
        <div id="slider-labels" class="flex justify-between text-[10px] font-mono text-mid-gray dark:text-dark-mid-gray mb-3"></div>
        <div id="resolution-breakdown" class="space-y-1.5"></div>
      </div>

      <div class="card">
        <h2 class="font-display text-sm font-medium text-ink dark:text-dark-ink mb-3">{ui.upgradePath}</h2>
        <div id="upgrade-path" class="space-y-2"></div>
      </div>

      <div class="card">
        <h2 class="font-display text-sm font-medium text-ink dark:text-dark-ink mb-3">{ui.tips}</h2>
        <div id="tips" class="text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed space-y-2"></div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="gpus-data" set:html={JSON.stringify(gpusData.gpus)}></script>
<script type="application/json" id="cpus-data" set:html={JSON.stringify(cpusData.cpus)}></script>
<script type="application/json" id="games-data" set:html={JSON.stringify(gamesData.games)}></script>
<script type="application/json" id="calc-i18n" set:html={JSON.stringify(ui)}></script>

<script type="module">
function fuzzyMatch(text, query) {
  text = text.toLowerCase();
  query = query.toLowerCase().trim();
  if (!query) return true;
  let qi = 0;
  for (let ti = 0; ti < text.length && qi < query.length; ti++) {
    if (text[ti] === query[qi]) qi++;
  }
  return qi === query.length;
}

function setupFilteredSelect(inputId, selectId, items, labelKey) {
  const input = document.getElementById(inputId);
  const select = document.getElementById(selectId);
  if (!input || !select) return;

  input.addEventListener('input', () => {
    const query = input.value;
    const selectedValue = select.value;

    select.innerHTML = items.reduce((acc, item, index) => {
      if (fuzzyMatch(item[labelKey], query)) {
        return acc + `<option value="${index}">${item[labelKey]}</option>`;
      }
      return acc;
    }, '')

    if (selectedValue && items[parseInt(selectedValue, 10)]) {
      const stillVisible = [...select.options].some(o => o.value === selectedValue);
      if (stillVisible) select.value = selectedValue;
    }
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && select.options.length > 0) {
      select.value = select.options[0].value;
      select.dispatchEvent(new Event('change', { bubbles: true }));
    }
  });
}
const i18n = JSON.parse(document.getElementById('calc-i18n').textContent);

const $ = (id) => document.getElementById(id);

const BAND_ORDER = ['entry', 'mid', 'high', 'top'];

function scoreBand(score) {
  if (score < 45) return 'entry';
  if (score < 65) return 'mid';
  if (score < 85) return 'high';
  return 'top';
}

function pickUpgrades(current, pool, counterpart, count = 3) {
  const curIdx = BAND_ORDER.indexOf(scoreBand(current.score));
  const pairIdx = BAND_ORDER.indexOf(scoreBand(counterpart.score));
  const targetIdx = Math.min(Math.max(curIdx + 1, pairIdx), BAND_ORDER.length - 1);
  const targetBand = BAND_ORDER[targetIdx];
  const cap = Math.round(counterpart.score * 1.5);
  const inBand = pool
    .filter(p => scoreBand(p.score) === targetBand && p.score > current.score)
    .sort((a, b) => b.score - a.score);
  const picks = new Set(inBand.filter(p => p.score <= cap));
  for (const p of inBand) {
    if (picks.size >= count) break;
    if (!picks.has(p)) picks.add(p);
  }
  return Array.from(picks).slice(0, count);
}

let gpus = [], cpus = [], games = [];
let _lastGpu = null, _lastCpu = null, _lastGame = null, _lastConfig = null;



async function loadData() {
  gpus = JSON.parse(document.getElementById('gpus-data').textContent);
  cpus = JSON.parse(document.getElementById('cpus-data').textContent);
  games = JSON.parse(document.getElementById('games-data').textContent);
}

function populateSelect(selectId, items, labelKey, placeholder) {
  const sel = $(selectId);
  if (!sel) return;
  sel.innerHTML = `<option value="">${placeholder}</option>` +
    items.map((item, i) =>
    `<option value="${i}">${item[labelKey]}</option>`
  ).join('');
}

(async () => {
  try {
    await loadData();

    populateSelect('gpu', gpus, 'name', i18n.selectGpu || 'GPU');
    populateSelect('cpu', cpus, 'name', i18n.selectCpu || 'CPU');
    populateSelect('game', games, 'title', i18n.selectGame || 'game');
    setupFilteredSelect('gpu-search', 'gpu', gpus, 'name');
    setupFilteredSelect('cpu-search', 'cpu', cpus, 'name');
    setupFilteredSelect('game-search', 'game', games, 'title');

    $('calc-skeleton')?.classList.add('hidden');
    $('calc-placeholder')?.classList.remove('hidden');

    $('advanced-toggle')?.addEventListener('click', () => {
      const adv = $('advanced-options');
      const toggle = $('advanced-toggle');
      const isHidden = adv.classList.contains('hidden');
      adv.classList.toggle('hidden');
      toggle.textContent = isHidden ? '- ' + i18n.advanced : '+ ' + i18n.advanced;
      toggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
    });

    $('calculate-btn')?.addEventListener('click', calculate);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && gpus.length > 0) calculate();
    });

    // Manual calculation only via button click or Enter key

    readUrlParams();
  } catch (e) {
    console.error('RunFps calculator init error:', e);
  }
})();

function getSelectedValue(selectId, items) {
  const sel = $(selectId);
  return sel && sel.value !== '' ? items[parseInt(sel.value, 10)] : null;
}

function readUrlParams() {
  const params = new URLSearchParams(location.search);
  const setSelectByLabel = (selectId, param, items, labelKey) => {
    const val = params.get(param);
    if (val !== null && items) {
      const idx = items.findIndex(i => i[labelKey].toLowerCase().replace(/\s+/g, '-') === val.toLowerCase());
      if (idx >= 0) $(selectId).value = '' + idx;
    }
  };
  setSelectByLabel('gpu', 'gpu', gpus, 'name');
  setSelectByLabel('cpu', 'cpu', cpus, 'name');
  setSelectByLabel('game', 'game', games, 'title');
  if ($('ram-capacity') && params.get('ram')) $('ram-capacity').value = params.get('ram');
  if ($('resolution') && params.get('resolution')) $('resolution').value = params.get('resolution');
  if ($('preset') && params.get('preset')) $('preset').value = params.get('preset');

  const cpuSel = $('cpu');
  const gameSel = $('game');
  if (cpuSel?.value && gameSel?.value) {
    setTimeout(calculate, 100);
  }
}

function updateUrl() {
  const params = new URLSearchParams();
  const gpu = getSelectedValue('gpu', gpus);
  const cpu = getSelectedValue('cpu', cpus);
  const game = getSelectedValue('game', games);
  if (gpu) params.set('gpu', gpu.name.toLowerCase().replace(/\s+/g, '-'));
  if (cpu) params.set('cpu', cpu.name.toLowerCase().replace(/\s+/g, '-'));
  if (game) params.set('game', game.title.toLowerCase().replace(/\s+/g, '-'));
  params.set('ram', $('ram-capacity')?.value || '16');
  params.set('resolution', $('resolution')?.value || '1080p');
  params.set('preset', $('preset')?.value || 'high');
  const qs = params.toString();
  const url = qs ? `${location.pathname}?${qs}` : location.pathname;
  history.replaceState(null, '', url);
}

function calculate() {
  const gpu = getSelectedValue('gpu', gpus);
  const cpu = getSelectedValue('cpu', cpus);
  const game = getSelectedValue('game', games);

  if (!cpu || !game) {
    $('results').classList.add('hidden');
    $('results-container').classList.remove('hidden');
    $('calc-skeleton').classList.add('hidden');
    $('calc-placeholder').classList.remove('hidden');
    $('calc-placeholder').querySelector('p').textContent = i18n.noCpuGame;
    $('results-container').focus();
    return;
  }

  let actualGpu = gpu;
  if (!actualGpu) {
    if (cpu.igpuScore) {
      actualGpu = { name: cpu.name + ' iGPU', score: cpu.igpuScore, vram: cpu.igpuScore >= 20 ? 4 : cpu.igpuScore >= 10 ? 2 : 1, brand: cpu.brand };
    } else {
      $('results').classList.add('hidden');
      $('results-container').classList.remove('hidden');
      $('calc-skeleton').classList.add('hidden');
      $('calc-placeholder').classList.remove('hidden');
      $('calc-placeholder').querySelector('p').textContent = i18n.noGpu.replace('{cpu}', cpu.name);
      $('results-container').focus();
      return;
    }
  }

  updateUrl();

  _lastGpu = actualGpu; _lastCpu = cpu; _lastGame = game;
  const config = {
    ramCapacity: parseInt($('ram-capacity')?.value || '16', 10),
    ramType: $('ram-type')?.value || 'ddr5',
    ramSpeed: 6000,
    ramChannel: 'dual',
    storage: $('storage')?.value || 'nvme',
    resolution: $('resolution')?.value || '1080p',
    preset: $('preset')?.value || 'high',
    rtEnabled: $('rt')?.value === 'true',
    upscaling: $('upscaling')?.value || 'none',
    resolutionScale: 100,
    frameCap: parseInt($('frame-cap')?.value || '0', 10),
    monitorHz: 144,
    vramLimit: 0,
    os: $('os')?.value || 'windows'
  };
  _lastConfig = config;
  const result = window.RunFpsEngine.calculateFPS(config, game, actualGpu, cpu);

  showResults(result, actualGpu, cpu, game, config);
}

function showResults(result, gpu, cpu, game, config) {
  const res = $('results');
  $('results-container').classList.add('hidden');
  res.classList.remove('hidden');
  res.focus();

  const fpsEl = $('fps-number');
  const targetFps = result.avgFps;
  fpsEl.style.animation = 'none';
  fpsEl.offsetHeight;
  fpsEl.style.animation = 'count-up 300ms ease-out';
  animateCounter(fpsEl, targetFps, 300);

  $('fps-label').textContent = i18n.averageFps;
  $('p1-low').textContent = result.p1Low;
  $('p01-low').textContent = result.p01Low;
  $('rating-badge').textContent = result.rating;
  $('rating-badge').style.background = result.rating === 'Elite' || result.rating === 'High Refresh' ? '#0a0a0a' : result.rating === 'Smooth' ? '#171717' : result.rating === 'Playable' ? '#737373' : '#e7000b';
  $('rating-badge').style.color = result.rating === 'Playable' || result.rating === 'Unplayable' ? '#ffffff' : '#fafafa';

  if (result.fpsCapped) {
    $('fps-label').textContent = i18n.cappedAt.replace('{fps}', config.frameCap);
  }

  animateBar('cpu-bar', result.cpuLoad);
  animateBar('gpu-bar', result.gpuLoad);
  $('cpu-load-text').textContent = `${result.cpuLoad}%`;
  $('gpu-load-text').textContent = `${result.gpuLoad}%`;
  $('bottleneck-text').textContent = i18n.bottleneck.replace('{b}', result.bottleneck).replace('{p}', result.bottleneckPercent);

  const presetBreakdown = $('preset-breakdown');
  presetBreakdown.innerHTML = '';
  const presets = [
    { label: i18n.low, value: 'low' },
    { label: i18n.medium, value: 'medium' },
    { label: i18n.high, value: 'high' },
    { label: i18n.ultra, value: 'ultra' }
  ];
  const presetMuls = { low: 1.4, medium: 1.15, high: 0.9, ultra: 0.7 };
  const currentPresetMul = presetMuls[config.preset] || 0.9;
  for (const p of presets) {
    const fps = Math.round(result.avgFps * presetMuls[p.value] / currentPresetMul);
    const maxFps = presets.reduce((max, pr) => Math.max(max, Math.round(result.avgFps * presetMuls[pr.value] / currentPresetMul)), 0);
    const barWidth = (fps / maxFps) * 100;
    presetBreakdown.innerHTML += `
      <div>
        <div class="flex justify-between text-xs font-mono mb-0.5">
          <span class="text-mid-gray dark:text-dark-mid-gray">${p.label}</span>
          <span class="text-ink dark:text-dark-ink font-medium">${fps} ${i18n.fps}</span>
        </div>
        <div class="h-1.5 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
          <div class="h-full bg-ink dark:bg-dark-ink rounded-full transition-all duration-500" style="width:${barWidth}%"></div>
        </div>
      </div>`;
  }

  const resBreakdown = $('resolution-breakdown');
  resBreakdown.innerHTML = '';
  const resolutions = [
    { label: '720p', scale: 1.25 },
    { label: '800p', scale: 1.18 },
    { label: '1080p', scale: 1.0 },
    { label: '1440p', scale: 0.72 },
    { label: '4K', scale: 0.45 }
  ];
  const resScales = { '720p': 1.25, '800p': 1.18, '1080p': 1.0, '1440p': 0.72, '4K': 0.45 };
  const currentResScale = resScales[config.resolution] || 1.0;
  for (const r of resolutions) {
    const fps = Math.round(result.avgFps * r.scale / currentResScale);
    const barWidth = (r.scale / 1.25) * 100;
    const isSelected = r.label.toLowerCase() === config.resolution.toLowerCase();
    resBreakdown.innerHTML += `
      <div class="${isSelected ? 'opacity-100' : 'opacity-60'}">
        <div class="flex justify-between text-xs font-mono mb-0.5">
          <span class="text-mid-gray dark:text-dark-mid-gray">${r.label}</span>
          <span class="text-ink dark:text-dark-ink font-medium">${fps} ${i18n.fps}</span>
        </div>
        <div class="h-1.5 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
          <div class="h-full bg-mid-gray dark:bg-dark-mid-gray rounded-full transition-all duration-500" style="width:${barWidth}%"></div>
        </div>
      </div>`;
  }

  const upgradePath = $('upgrade-path');
  const gpuUpgrades = pickUpgrades(gpu, gpus, cpu);
  const cpuUpgrades = pickUpgrades(cpu, cpus, gpu);

  const renderUpgradeRow = (upg, isCpu, barWidth) => {
    const upgResult = window.RunFpsEngine.calculateFPS(config, game, isCpu ? gpu : upg, isCpu ? upg : cpu);
    const gainPct = Math.round((upgResult.avgFps / result.avgFps - 1) * 100);
    const gainFps = Math.round(upgResult.avgFps - result.avgFps);
    const sub = isCpu
      ? `${upg.generation} &middot; ${upg.cores}C/${upg.threads}T`
      : `${upg.generation} &middot; ${upg.vram}GB VRAM`;
    return `<div>
      <div class="flex justify-between text-xs font-mono mb-0.5">
        <span class="text-ink dark:text-dark-ink">${upg.name}</span>
        <span class="text-mid-gray dark:text-dark-mid-gray">+${gainPct}% <span class="font-medium text-ink dark:text-dark-ink">${gainFps} ${i18n.fps}</span></span>
      </div>
      <div class="text-[11px] text-mid-gray dark:text-dark-mid-gray font-mono mb-1">${sub}</div>
      <div class="h-1.5 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
        <div class="h-full bg-ink-soft dark:bg-dark-ink-soft rounded-full transition-all duration-500" style="width:${barWidth}%"></div>
      </div>
    </div>`;
  };

  const renderUpgradeSection = (label, items, isCpu) => {
    if (items.length === 0) {
      return `<h3 class="text-xs font-semibold uppercase tracking-wide text-mid-gray dark:text-dark-mid-gray mb-2">${label}</h3>
        <p class="text-xs text-mid-gray dark:text-dark-mid-gray">${isCpu ? i18n.topTierCpu : i18n.topTierGpu}</p>`;
    }
    const gains = items.map(u => {
      const r = window.RunFpsEngine.calculateFPS(config, game, isCpu ? gpu : u, isCpu ? u : cpu);
      return Math.round(r.avgFps - result.avgFps);
    });
    const maxGain = Math.max(...gains, 1);
    return `<h3 class="text-xs font-semibold uppercase tracking-wide text-mid-gray dark:text-dark-mid-gray mb-2">${label}</h3>` +
      items.map((u, i) => renderUpgradeRow(u, isCpu, (gains[i] / maxGain) * 100)).join('');
  };

  upgradePath.innerHTML =
    renderUpgradeSection(i18n.upgradeGpu, gpuUpgrades, false) +
    renderUpgradeSection(i18n.upgradeCpu, cpuUpgrades, true);

  const tips = $('tips');
  tips.innerHTML = '';
  const tipList = [];
  if (result.bottleneck === 'CPU') tipList.push(i18n.tipCpu.replace('{cpu}', cpu.name).replace('{gpu}', gpu.name).replace('{p}', result.bottleneckPercent));
  if (result.bottleneck === 'GPU') tipList.push(i18n.tipGpu.replace('{gpu}', gpu.name));
  if (!config.rtEnabled && game.ray_tracing) tipList.push(i18n.tipRt);
  if (config.upscaling === 'none' && (game.dlss || game.fsr)) tipList.push(i18n.tipUpscaling);
  if (config.frameCap > 0 && result.avgFps > config.frameCap) tipList.push(i18n.tipFrameCap.replace('{fps}', config.frameCap));

  if (tipList.length === 0) {
    tipList.push(i18n.noTips);
  }
  tipList.forEach(t => { tips.innerHTML += `<p>${t}</p>`; });
}

function animateCounter(el, target, duration) {
  const start = performance.now();
  function step(now) {
    const elapsed = now - start;
    const progress = Math.min(elapsed / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    el.textContent = Math.round(eased * target);
    if (progress < 1) requestAnimationFrame(step);
    else el.textContent = target;
  }
  requestAnimationFrame(step);
}

function animateBar(barId, value) {
  const bar = $(barId);
  if (bar) {
    bar.style.transition = 'none';
    bar.style.width = '0%';
    bar.offsetHeight;
    bar.style.transition = 'width 500ms ease-out';
    bar.style.width = `${Math.min(100, value)}%`;
  }
}

const sliderResolutions = ['720p', '800p', '1080p', '1440p', '4K'];
const sliderLabels = $('slider-labels');
sliderResolutions.forEach((r, i) => {
  const span = document.createElement('span');
  span.textContent = r;
  span.className = i === 2 ? 'text-ink dark:text-dark-ink font-medium' : '';
  sliderLabels.appendChild(span);
});

let sliderTimer;
$('res-slider')?.addEventListener('input', function() {
  clearTimeout(sliderTimer);
  const slider = this;
  sliderTimer = setTimeout(() => {
    if (!_lastGpu || !_lastCpu || !_lastGame || !_lastConfig) return;
    const res = sliderResolutions[parseInt(slider.value, 10)];
    const cfg = { ..._lastConfig, resolution: res };
    const result = window.RunFpsEngine.calculateFPS(cfg, _lastGame, _lastGpu, _lastCpu);

    $('slider-fps').textContent = `${result.avgFps} ${i18n.fps}`;

    const fpsEl = $('fps-number');
    fpsEl.textContent = result.avgFps;
    $('p1-low').textContent = result.p1Low;
    $('p01-low').textContent = result.p01Low;
    $('fps-label').textContent = i18n.averageFps;
    if (result.fpsCapped) {
      $('fps-label').textContent = i18n.cappedAt.replace('{fps}', cfg.frameCap);
    }
    $('rating-badge').textContent = result.rating;
    $('rating-badge').style.background = result.rating === 'Elite' || result.rating === 'High Refresh' ? '#0a0a0a' : result.rating === 'Smooth' ? '#171717' : result.rating === 'Playable' ? '#737373' : '#e7000b';
    $('rating-badge').style.color = result.rating === 'Playable' || result.rating === 'Unplayable' ? '#ffffff' : '#fafafa';

    animateBar('cpu-bar', result.cpuLoad);
    animateBar('gpu-bar', result.gpuLoad);
    $('cpu-load-text').textContent = `${result.cpuLoad}%`;
    $('gpu-load-text').textContent = `${result.gpuLoad}%`;
    $('bottleneck-text').textContent = i18n.bottleneck.replace('{b}', result.bottleneck).replace('{p}', result.bottleneckPercent);

    const resBreakdown = $('resolution-breakdown');
    resBreakdown.innerHTML = '';
    const resScales = { '720p': 1.25, '800p': 1.18, '1080p': 1.0, '1440p': 0.72, '4K': 0.45 };
    const currentResScale = resScales[res] || 1.0;
    for (const r2 of sliderResolutions) {
      const fps = Math.round(result.avgFps * (resScales[r2] || 1.0) / currentResScale);
      const barWidth = ((resScales[r2] || 1.0) / 1.25) * 100;
      const isSelected = r2 === res;
      resBreakdown.innerHTML += `
        <div class="${isSelected ? 'opacity-100' : 'opacity-60'}">
          <div class="flex justify-between text-xs font-mono mb-0.5">
            <span class="text-mid-gray dark:text-dark-mid-gray">${r2}</span>
            <span class="text-ink dark:text-dark-ink font-medium">${fps} ${i18n.fps}</span>
          </div>
          <div class="h-1.5 bg-canvas dark:bg-dark-canvas rounded-full overflow-hidden">
            <div class="h-full bg-mid-gray dark:bg-dark-mid-gray rounded-full transition-all duration-500" style="width:${barWidth}%"></div>
          </div>
        </div>`;
    }

    document.querySelectorAll('#slider-labels span').forEach((sp, i) => {
      sp.className = i === parseInt(slider.value, 10) ? 'text-ink dark:text-dark-ink font-medium' : '';
    });
  }, 75);
});
</script>

</Layout>

