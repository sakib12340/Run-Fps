---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { locales } from '../i18n/translations.js';
import { useTranslations } from '../i18n/utils.js';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  robots?: string;
}

const { title, description, canonical, ogImage, robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" } = Astro.props;
const url = Astro.url;
const pathname = url.pathname;
const segments = pathname.split('/').filter(Boolean);
const currentLocale = locales.includes(segments[0]) ? segments[0] : 'en';
const { t } = useTranslations(currentLocale);
const pathWithoutLocale = pathname.replace(/^\/[^\/]+/, '') || '/';
const canonicalUrl = canonical || `https://runfps.com${pathname}`;
const defaultOgImage = 'https://runfps.com/web-app-manifest-512x512.png';
const ogImageAbsolute = ogImage ? (ogImage.startsWith('http') ? ogImage : `https://runfps.com${ogImage}`) : defaultOgImage;
const htmlLang = currentLocale;
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | RunFps</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="RunFps" />
    <link rel="manifest" href="/site.webmanifest" />

    {locales.map(l => (
      <link rel="alternate" hreflang={l} href={`https://runfps.com/${l}${pathWithoutLocale}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://runfps.com/en${pathWithoutLocale}`} />

    <meta name="robots" content={robots} />
    <meta name="author" content="RunFps" />
    <meta name="format-detection" content="telephone=no" />
    <meta property="og:title" content={`${title} | RunFps`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RunFps" />
    <meta property="og:locale" content={htmlLang} />
    {locales.filter(l => l !== htmlLang).map(l => (
      <meta property="og:locale:alternate" content={l} />
    ))}
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | RunFps`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="theme-color" content="#f5f5f5" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "RunFps",
      "url": "https://runfps.com",
      "description": "Check your FPS in any game. Free PC gaming performance calculator and bottleneck analyzer.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://runfps.com/en/games?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "RunFps",
      "url": "https://runfps.com",
      "logo": "https://runfps.com/web-app-manifest-512x512.png"
    }
    </script>
    <style>
      @font-face { font-family: 'Space Grotesk'; src: url('/fonts/SpaceGrotesk-Variable.woff2') format('woff2'); font-display: swap; font-weight: 300 700; }
      @font-face { font-family: 'Inter'; src: url('/fonts/Inter-400.woff2') format('woff2'); font-display: swap; font-weight: 400; }
      @font-face { font-family: 'Inter'; src: url('/fonts/Inter-500.woff2') format('woff2'); font-display: swap; font-weight: 500; }
      @font-face { font-family: 'JetBrains Mono'; src: url('/fonts/JetBrainsMono-Variable.woff2') format('woff2'); font-display: swap; font-weight: 400 500; }
    </style>
    <link rel="preload" href="/fonts/SpaceGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Inter-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Inter-500.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/JetBrainsMono-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('runfps-theme');
        } catch(e) {
          var stored = null;
        }
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function() {
            navigator.serviceWorker.register('/sw.js');
          });
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">{t('misc.skipToContent')}</a>
    <Header currentLocale={currentLocale} />
    <main id="main-content" class="flex-1 w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
      <slot />
    </main>
    <Footer currentLocale={currentLocale} />
    <button id="go-up" class="go-up-btn" aria-label={t('misc.scrollToTop')}>
      <Icon name="lucide:chevron-up" size={18} />
    </button>
    <script is:inline>
    (function() {
      var el = document.getElementById('go-up');
      if (!el) return;
      function toggle() {
        el.classList.toggle('visible', (window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0) > 200);
      }
      el.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
      window.addEventListener('scroll', toggle, { passive: true });
      toggle();
      setTimeout(toggle, 100);
      setTimeout(toggle, 500);
    })();
    </script>



  </body>
</html>

