---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Icon } from 'astro-icon/components';
import { locales } from '../i18n/translations.js';
import { useTranslations } from '../i18n/utils.js';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
}

const { title, description, canonical, ogImage } = Astro.props;
const url = Astro.url;
const pathname = url.pathname;
const segments = pathname.split('/').filter(Boolean);
const currentLocale = locales.includes(segments[0]) ? segments[0] : 'en';
const { t } = useTranslations(currentLocale);
const pathWithoutLocale = pathname.replace(/^\/[^\/]+/, '') || '/';
const canonicalUrl = canonical || `https://runfps.com${pathname}`;
const defaultOgImage = '/web-app-manifest-512x512.png';
const htmlLang = currentLocale;
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | RunFps</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="RunFps" />
    <link rel="manifest" href="/site.webmanifest" />

    {locales.map(l => (
      <link rel="alternate" hreflang={l} href={`https://runfps.com/${l}${pathWithoutLocale}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://runfps.com/en${pathWithoutLocale}`} />

    <meta property="og:title" content={`${title} | RunFps`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RunFps" />
    <meta property="og:image" content={ogImage || defaultOgImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:image" content={ogImage || defaultOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | RunFps`} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#f5f5f5" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <script is:inline type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "RunFps",
      "url": "https://runfps.com",
      "description": "Check your FPS in any game. Free PC gaming performance calculator and bottleneck analyzer.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://runfps.com/en/games?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    <style>
      @font-face { font-family: 'Space Grotesk'; src: url('/fonts/SpaceGrotesk-Variable.woff2') format('woff2'); font-display: swap; font-weight: 300 700; }
      @font-face { font-family: 'Inter'; src: url('/fonts/Inter-400.woff2') format('woff2'); font-display: swap; font-weight: 400; }
      @font-face { font-family: 'Inter'; src: url('/fonts/Inter-500.woff2') format('woff2'); font-display: swap; font-weight: 500; }
      @font-face { font-family: 'JetBrains Mono'; src: url('/fonts/JetBrainsMono-Variable.woff2') format('woff2'); font-display: swap; font-weight: 400 500; }
    </style>
    <link rel="preload" href="/fonts/SpaceGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Inter-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/Inter-500.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/JetBrainsMono-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('runfps-theme');
        } catch(e) {
          var stored = null;
        }
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function() {
            navigator.serviceWorker.register('/sw.js');
          });
        }
      })();
    </script>
    <!-- Google AdSense Auto Ads — REPLACE ca-pub-XXXXXXXXXXXXXXXX with your publisher ID after Google approval (spot 1 of 2; spot 2 is public/ads.txt) -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXXXXXXXX" crossorigin="anonymous"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">{t('misc.skipToContent')}</a>
    <Header currentLocale={currentLocale} />
    <main id="main-content" class="flex-1 w-full max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
      <slot />
    </main>
    <Footer currentLocale={currentLocale} />
    <button id="go-up" class="go-up-btn" aria-label={t('misc.scrollToTop')}>
      <Icon name="lucide:chevron-up" size={18} />
    </button>
    <script is:inline>
    (function() {
      var el = document.getElementById('go-up');
      if (!el) return;
      function toggle() {
        el.classList.toggle('visible', (window.scrollY || window.pageYOffset || document.documentElement.scrollTop || 0) > 200);
      }
      el.addEventListener('click', function() {
        window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      });
      window.addEventListener('scroll', toggle, { passive: true });
      toggle();
      setTimeout(toggle, 100);
      setTimeout(toggle, 500);
    })();
    </script>

    <div id="ad-bait" class="ad-container adsbygoogle" style="position:absolute;left:-9999px;width:1px;height:1px;pointer-events:none;" aria-hidden="true"></div>

    <div id="adblock-notice" class="fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-300 ease-in-out bg-paper dark:bg-dark-paper border-t border-hairline dark:border-dark-hairline shadow-lg">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-3">
        <p class="text-xs sm:text-sm text-mid-gray dark:text-dark-mid-gray leading-relaxed">
          {t('misc.adblockNotice')}
          <span class="text-ink dark:text-dark-ink font-medium">{t('misc.adblockThanks')}</span>
        </p>
        <button id="adblock-dismiss" class="shrink-0 px-3 py-1.5 text-xs font-medium rounded-pill bg-ink text-paper dark:bg-dark-ink dark:text-dark-canvas border-0 cursor-pointer hover:scale-[1.02] transition-all duration-120">{t('misc.adblockDismiss')}</button>
      </div>
    </div>

    <script>
      (function() {
        var bait = document.getElementById('ad-bait');
        if (bait && !bait.offsetHeight) {
          var notice = document.getElementById('adblock-notice')!;
          if (notice) {
            setTimeout(function() { notice.classList.remove('translate-y-full'); }, 1000);
            document.getElementById('adblock-dismiss')?.addEventListener('click', function() {
              notice.classList.add('translate-y-full');
            });
          }
        }
      })();
    </script>

  </body>
</html>

